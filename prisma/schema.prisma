model Patient {
  id             Int           @id @default(autoincrement())
  hospital_Id    Int
  user_Id        String
  name           String
  phone          Json
  email          Json
  photo          String?       @default("null")
  status         PatientStatus @default(ACTIVE)
  address        Json?
  dob            DateTime
  gender         String?
  bldGrp         String?
  currentProblem String?
  medicalHistory String?
  height         Float?
  weight         Float?
  bp             String?
  sugar          String?
  custom         Json?
  tempCreatedAt  DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  Consultation         Consultation[]
  Treatment            Treatment[]
  MedicineAndInjection MedicineAndInjection[]      @relation("Patient_MedicineAndInjection")
  TestingAndScanning   TestingAndScanningPatient[]
  Payments             Payment[]

  Hospital Hospital @relation(fields: [hospital_Id], references: [id])
  User     User     @relation(fields: [hospital_Id, user_Id], references: [hospital_Id, user_Id])

  @@unique([hospital_Id, user_Id])
}

