generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  // url      = "mysql://root:pass%403264@localhost:3306/hospital_management"
  url      = "mysql://schoolAttendance:Sensarsoft%40123@[2a02:4780:12:f6a7::1]:3306/hospital_management"
}

enum HospitalStatus {
  ACTIVE
  INACTIVE
}

enum AdminStatus {
  ACTIVE
  INACTIVE
}

enum PatientStatus {
  ACTIVE
  INACTIVE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Hospital {
  id                    Int                          @id @default(autoincrement())
  name                  String
  address               String
  photo                 String
  HospitalStatus        HospitalStatus               @default(ACTIVE)
  phone                 String
  mail                  String
  Users                 User[]
  Admins                Admin[]
  Patients              Patient[]
  Consultation          Consultation[]
  Treatments            Treatment[]
  Medicians             Medician[]
  Injections            Injection[]
  TestingAndScannings   TestingAndScanningPatient[]
  TestingAndScanningHs  TestingAndScanningHospital[]
  RoomsAvailables       RoomsAvailable[]
  Payments              Payment[]
  MedicineAndInjections MedicineAndInjection[]
  Fees                  Fees[]
}

model User {
  id          Int       @id @default(autoincrement())
  hospital_Id Int
  user_Id     String
  password    String
  role        String
  // AdminStrator AdminStrator[]
  Admin       Admin[]
  Patient     Patient[]
  Hospital    Hospital  @relation(fields: [hospital_Id], references: [id])

  @@unique([hospital_Id, user_Id])
}

model Admin {
  id           Int            @id @default(autoincrement())
  hospital_Id  Int
  user_Id      String
  name         String
  designation  String?
  role         String // e.g., Doctor, Nurse, Admin
  specialist   String?
  phone        String
  email        String
  address      String
  photo        String?        @default("https://cdn-icons-png.flaticon.com/512/387/387561.png")
  status       AdminStatus    @default(ACTIVE)
  gender       String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  Consultation Consultation[]
  Doctor       Treatment[]    @relation("Doctor_Treatment")
  Staff        Treatment[]    @relation("Staff_Treatment")
  Hospital     Hospital       @relation(fields: [hospital_Id], references: [id])
  User         User           @relation(fields: [hospital_Id, user_Id], references: [hospital_Id, user_Id])

  @@unique([hospital_Id, user_Id])
}

model AdminStrator {
  id          Int    @id @default(autoincrement())
  user_Id     String
  name        String
  status      String
  designation String // was 'destination'
  phone       String
  email       String
  photo       String
  address     String
  gender      String
  // User         User    @relation(fields: [user_Id], references: [user_Id])
}

