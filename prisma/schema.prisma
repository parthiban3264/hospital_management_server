model cosmetic {
  id          Int      @id @default(autoincrement())
  hospital_Id Int
  name        String
  type        String? // consider enum if limited set
  unit        String?
  imageUrl    String?  @db.Text
  stock       Int      @default(0)
  amount      Float
  staff_Id    Int
  Hospital    Hospital @relation(fields: [hospital_Id], references: [id])
}

model TestingAndScanningHospital {
  id          Int      @id @default(autoincrement())
  hospital_Id Int
  type        String // consider enum if limited set
  status      String // consider enum
  roomNo      String
  staff_Id    Int
  amount      Float
  Hospital    Hospital @relation(fields: [hospital_Id], references: [id])
}

model MedicineAndInjection {
  id          Int   @id @default(autoincrement())
  hospital_Id Int
  patient_Id  Int
  doctor_Id   Json // Array/object
  staff_Id    Json? // Array/object

  medicine_Id       Json? // Array/object
  dosageMedicine    Json?
  medicineNotes     Json?
  frequencyMedicine Json?
  durationMedicine  Json?
  medicineStatus    Boolean @default(false) // consider enum

  injection_Id       Json?
  dosageInjection    Json?
  InjectionNotes     Json?
  frequencyInjection Json?
  durationInjection  Json?
  injectionStatus    Boolean @default(false)

  status        Status      @default(PENDING) // consider enum
  paymentStatus Boolean     @default(false)
  createdAt     DateTime    @default(now())
  Hospital      Hospital    @relation(fields: [hospital_Id], references: [id])
  //Patient       Patient     @relation("Patient_MedicineAndInjection", fields: [patient_Id, hospital_Id], references: [user_Id, hospital_Id])
  Patient       Patient     @relation("Patient_MedicineAndInjection", fields: [patient_Id], references: [id])
  Medician      Medician[]  @relation("MedicineAndInjection_Medician")
  Injection     Injection[] @relation("Injection_MedicineAndInjection")
  Tonic         Tonic[]     @relation("Tonic_MedicineAndInjection")
}

enum TestingAndScanningStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  PENDING
}

