model Payment {
  id              Int           @id @default(autoincrement())
  hospital_Id     Int
  patient_Id      Int
  staff_Id        String?
  consultation_Id Int?
  reason          String
  status          PaymentStatus @default(PENDING)
  amount          Float?
  paymentType     PaymentType?
  type            Type?
  transactionId   Json?
  billingId       String?
  createdBy       String?
  updategdBy      String?
  createdAt       String
  updatedAt       String?
  Hospital        Hospital      @relation(fields: [hospital_Id], references: [id])
  //Patient                    Patient                     @relation(fields: [patient_Id, hospital_Id], references: [user_Id, hospital_Id])
  Patient         Patient       @relation(fields: [patient_Id], references: [id])

  TestingAndScanningPatients TestingAndScanningPatient[]
  MedicinePatient            MedicinePatient[]
  InjectionPatient           InjectionPatient[]
  TonicPatient               TonicPatient[]
  Consultation               Consultation?               @relation(fields: [consultation_Id], references: [id])
}

model RoomsAvailable {
  id          Int      @id @default(autoincrement())
  hospital_Id Int
  staff_Id    String
  roomNo      String
  capacity    Int
  notes       String
  type        String // consider enum if limited set // e.g., ICU, General, Private
  amount      Float
  Hospital    Hospital @relation(fields: [hospital_Id], references: [id])
}

model Fees {
  id          Int      @id @default(autoincrement())
  hospital_Id Int
  type        String?
  amount      Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  Hospital    Hospital @relation(fields: [hospital_Id], references: [id])
}

model MedicinePatient {
  id              Int     @id @default(autoincrement())
  hospital_Id     Int
  patient_Id      Int
  doctor_Id       String
  medicine_Id     Int
  consultation_Id Int?
  reason          String?
  quantity        Float
  reduceQuantity  Float?
  afterEat        Boolean
  morning         Boolean @default(false)
  afternoon       Boolean @default(false)
  night           Boolean @default(false)
  days            Int?    @default(0)
  reduceDays      Int?    @default(0)
  quantityNeeded  Float?
  tabletsCharge   Int?
  total           Float?
  status          Status  @default(PENDING)
  paymentStatus   Boolean @default(false)
  createdAt       String?
  updatedAt       String?

  payment_Id       Int?
  Payment          Payment?           @relation(fields: [payment_Id], references: [id])
  Hospital         Hospital           @relation(fields: [hospital_Id], references: [id])
  //Patient          Patient            @relation(fields: [patient_Id, hospital_Id], references: [user_Id, hospital_Id])
  Patient          Patient            @relation(fields: [patient_Id], references: [id])
  Medician         Medician           @relation(fields: [medicine_Id], references: [id])
  Consultation     Consultation?      @relation(fields: [consultation_Id], references: [id])
  MedicineProgress MedicineProgress[]
}

model InjectionPatient {
  id              Int     @id @default(autoincrement())
  hospital_Id     Int
  patient_Id      Int
  doctor_Id       String
  injection_Id    Int
  consultation_Id Int?
  reason          String?
  quantity        Int
  Doase           String?
  morning         Boolean @default(false)
  afternoon       Boolean @default(false)
  night           Boolean @default(false)
  days            Int?    @default(0)
  status          Status  @default(PENDING)
  total           Float?
  paymentStatus   Boolean @default(false)
  createdAt       String?
  updatedAt       String?

  payment_Id        Int?
  Payment           Payment?            @relation(fields: [payment_Id], references: [id])
  Hospital          Hospital            @relation(fields: [hospital_Id], references: [id])
  //Patient           Patient             @relation(fields: [patient_Id, hospital_Id], references: [user_Id, hospital_Id])
  Patient           Patient             @relation(fields: [patient_Id], references: [id])
  Injection         Injection           @relation(fields: [injection_Id], references: [id])
  Consultation      Consultation?       @relation(fields: [consultation_Id], references: [id])
  InjectionProgress InjectionProgress[]
}

model TonicPatient {
  id              Int     @id @default(autoincrement())
  hospital_Id     Int
  patient_Id      Int
  doctor_Id       String
  tonic_Id        Int
  consultation_Id Int?
  reason          String?
  quantity        Int
  reduceQuantity  Float?
  Doase           String?
  afterEat        Boolean
  morning         Boolean @default(false)
  afternoon       Boolean @default(false)
  night           Boolean @default(false)
  days            Int     @default(0)
  total           Float?
  status          Status  @default(PENDING)
  paymentStatus   Boolean @default(false)
  createdAt       String?
  updatedAt       String?

  payment_Id    Int?
  Payment       Payment?        @relation(fields: [payment_Id], references: [id])
  Hospital      Hospital        @relation(fields: [hospital_Id], references: [id])
  //Patient       Patient         @relation(fields: [patient_Id, hospital_Id], references: [user_Id, hospital_Id])
  Patient       Patient         @relation(fields: [patient_Id], references: [id])
  Tonic         Tonic           @relation(fields: [tonic_Id], references: [id])
  Consultation  Consultation?   @relation(fields: [consultation_Id], references: [id])
  TonicProgress TonicProgress[]
}

enum Types {
  SCAN
  TEST
}

