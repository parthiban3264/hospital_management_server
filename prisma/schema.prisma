model Injections {
  id                     Int       @id @default(autoincrement())
  hospital_Id             Int
  name                   String
  code                   String?  
  stock                  Json?     // { "1ml": 50, "2ml": 30 }
  packSize               Json?     // volume per pack
  freeUnits              Json?     
  costPrice              Json?     
  MRP                    Json?     
  PTR                    Json?     
  sellingPrice           Json?     
  discountPercent        Float?    
  HSNCode                String?   
  cgstPercent            Float?    
  sgstPercent            Float?    
  producerId             Int?      
  importerId             Int?      
  batchNumber            String?   
  expiryDate             DateTime?
  manufacturingDate      DateTime?
  minimumStock           Json?     
  reorderLevel           Json?     
  isPrescriptionRequired Boolean   @default(false)
  isActive               Boolean   @default(true)
  storageCondition       String?   
  notes                  String?   
  staffIds               Json?     
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @default(now())

  // Relations
  Hospital               Hospital  @relation(fields: [hospital_Id], references: [id])
manufacturer Manufacturer? @relation("InjectionManufacturer", fields: [producerId], references: [id])
importer Supplier? @relation("InjectionSupplier", fields: [importerId], references: [id])
  //injectionPatients      InjectionPatient[]
  injectionTransactions  InjectionTransaction[]  
  //MedicineAndInjection   MedicineAndInjection[] @relation("Injection_MedicineAndInjection")

   @@unique([hospital_Id, code])
}

model InjectionTransaction {
  id         Int      @id @default(autoincrement())
  injectionId Int
  type       String   // 'IN', 'OUT', 'GIVEAWAY', 'SALE', 'RETURN'
  packType   String?  // e.g., "1ml"
  quantity   Int
  description String?
  staffId    Int?
  createdAt  DateTime @default(now())
  injection  Injections @relation(fields: [injectionId], references: [id])
}


model Manufacturer {
  id        Int       @id @default(autoincrement())
  name      String
  contact   String?
  country   String?
  category  String    // 'Medicine', 'Tonic', 'Injection'
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  medicines Medicines[] @relation("MedicineManufacturer")
  tonics    Tonics[]    @relation("TonicManufacturer")
  injections Injections[] @relation("InjectionManufacturer")
}

model Supplier {
  id        Int       @id @default(autoincrement())
  name      String
  contact   String?
  country   String?
  category  String    // 'Medicine', 'Tonic', 'Injection'
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  medicines Medicines[] @relation("MedicineSupplier")
  tonics    Tonics[]    @relation("TonicSupplier")
  injections Injections[] @relation("InjectionSupplier")
}

