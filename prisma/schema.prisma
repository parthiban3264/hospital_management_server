  ManualPay
  OnlinePay
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum Type {
  REGISTRATIONFEE
  TESTINGFEESANDSCANNINGFEE
  TREATMENTFEE
  MEDICINEFEEANDINJECTIONFEE
  MEDICINETONICINJECTIONFEES
  ROOMCHARGE
  OTHER
}

