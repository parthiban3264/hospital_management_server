}
enum AppPaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUND
}

model Hospital {
  id                                      Int                                       @id @default(autoincrement()) //  @default(autoincrement())
  name                                    String
  address                                 String
  photo                                   String                                    @default("https://img.freepik.com/premium-vector/hospital-logo-design-vector-illustration-white-background_272204-8968.jpg?w=2000")
  HospitalStatus                          HospitalStatus                            @default(ACTIVE)
  phone                                   String
  mail                                    String
  Users                                   User[]
  Admins                                  Admin[]
  Patients                                Patient[]
  Consultation                            Consultation[]
  Wards                                   Wards[]
  Medicines                               Medicine[]
  MedicineBatch                           MedicineBatch[]
  StockMovements                          StockMovement[]
  Treatments                              Treatment[]
  Medicians                               Medician[]
  Injections                              Injection[]
  Tonics                                  Tonic[]
  TestingAndScannings                     TestingAndScanningPatient[]
  TestingAndScanningHs                    TestingAndScanningHospital[]
  RoomsAvailables                         RoomsAvailable[]
  Payments                                Payment[]
  Fees                                    Fees[]
  MedicinePatients                        MedicinePatient[]
  InjectionPatients                       InjectionPatient[]
  TonicPatients                           TonicPatient[]
  ScanAndTests                            ScanAndTest[]
  Drawers                                 Drawer[]
  IncomeAndExpenses                       IncomeAndExpense[]
  cosmetics                               cosmetic[]
  Tickets                                 Tickets[]
  ScanAndTest                             ScanAndTests[]
  Medicine                                Medicines[]
  Tonic                                   Tonics[]
  Injection                               Injections[]
  Admission                               Admission[]
  Prescription                            Prescription[]
  ScanAndTestUnitReferencewithPerHospital ScanAndTestUnitReferencewithPerHospital[]
  ScanAndTestsWithPerHospitals            ScanAndTestsWithPerHospital[]
  PrescriptionDispense                    PrescriptionDispense[]
  AppPayment AppPayment[]
}

model AppPayment {
  id            Int              @id @default(autoincrement())
  hospital_Id       Int
  baseAmount    Int
  gst           Float
  amount        Float
  paidAt        DateTime         @default(now())
  periodStart   DateTime
  periodEnd     DateTime
  transactionId String?
  status        AppPaymentStatus @default(PENDING)
  createdAt     DateTime         @default(now())

  Hospital     Hospital  @relation(fields: [hospital_Id], references: [id])
}

model User {
  id           Int       @id @default(autoincrement())
  hospital_Id  Int
  user_Id      String
  password     String
  role         String
  device_Id    String?   @db.Text
  sessionToken String?   @db.Text
  isLoggedIn   Boolean   @default(false)
  Admin        Admin[]
  Patient      Patient[]
  Hospital     Hospital  @relation(fields: [hospital_Id], references: [id])

  @@unique([hospital_Id, user_Id])
}

model Admin {
  id               Int            @id @default(autoincrement())
  hospital_Id      Int
  user_Id          String
  name             String
  designation      String?
  role             String // e.g., Doctor, Nurse, Admin
  accessDoctorRole Boolean        @default(false) // e.g., General Physician, Cardiologist, etc.
  accessAdminRole  Boolean        @default(false) // e.g., Super Admin, Finance Admin, etc.
  doctorAmount     Float?         @default(0)
  inPatientAmount     Float?         @default(0)
  specialist       String?
  assignDoctorId   String? // for Nurse/Staff to assign Doctor
  permissions      Json? // store [1,2,3] etc for Medical Staff; keep NULL for ADMIN
  phone            String
  email            String
  address          String
  photo            String?        @default("https://as2.ftcdn.net/v2/jpg/05/89/93/27/1000_F_589932782_vQAEAZhHnq1QCGu5ikwrYaQD0Mmurm0N.jpg")
  status           AdminStatus    @default(ACTIVE)
  gender           String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  Consultation     Consultation[]
  // DoctorAssignment Admission[]    @relation("DoctorAssignment")
  // NurseAssignment  Admission[]    @relation("NurseAssignment")
  Prescription     Prescription[]

  Doctor   Treatment[] @relation("Doctor_Treatment")
  Staff    Treatment[] @relation("Staff_Treatment")
  Hospital Hospital    @relation(fields: [hospital_Id], references: [id])
  User     User        @relation(fields: [hospital_Id, user_Id], references: [hospital_Id, user_Id])

  @@unique([hospital_Id, user_Id])
}

model ButtonPermissions {
  id          Int    @id @default(autoincrement())
  hospital_Id Int
  key         String
  designation String
  defaultIds  Json?

  @@unique([designation, key])
}

model AdminStrator {
  id          Int     @id @default(autoincrement())
  user_Id     String
  name        String
  status      String
  role        String
  designation String?
  phone       String
  email       String
  photo       String? @default("https://img.freepik.com/premium-vector/technology-concept-vector-illustration-featuring-consulting-design-flat-style-elements_1226483-4088.jpg?semt=ais_hybrid&w=740&q=80")
  address     String
  gender      String

  @@map("administrator")
}

model Patient {
  id          Int           @id @default(autoincrement())
  hospital_Id Int
  user_Id     String?
  staff_Id    String
  name        String
  ac_name     String?
  phone       Json
  email       Json
  photo       String?       @default("null")
  status      PatientStatus @default(ACTIVE)
  address     Json?

  dob                DateTime
  gender             String?
  bldGrp             String?
  currentProblem     String?
  medicalHistory     String?
  tempCreatedAt      DateTime?
  createdAt          String?
  updatedAt          String?
  Prescription       Prescription[]
  Consultation       Consultation[]
  Treatment          Treatment[]
  TestingAndScanning TestingAndScanningPatient[]
  Payments           Payment[]
  MedicinePatients   MedicinePatient[]
  InjectionPatients  InjectionPatient[]
  TonicPatients      TonicPatient[]
  Admission          Admission[]

  Hospital Hospital @relation(fields: [hospital_Id], references: [id])
  User     User?    @relation(fields: [hospital_Id, user_Id], references: [hospital_Id, user_Id])
  //@@unique([id,hospital_Id])
}

enum Status {
  SCHEDULED
  COMPLETED
  CANCELLED
  ENDPROCESS
  ENDPROCESSING
  ONGOING
  PENDING
  ABANDONED
}

enum QueueStatus {
  PENDING
  ONGOING
  DRQUEUE
  COMPLETED
  CANCELLED
}

model Consultation {
  id          Int    @id @default(autoincrement())
  hospital_Id Int
  patient_Id  Int
  doctor_Id   String
  purpose     String

  // ✅ TOKEN SYSTEM
  tokenNo   Int?
  tokenDate DateTime?

  symptoms             Boolean     @default(false)
  notes                Json?
  referredByDoctorName String?
  registrationFee      Float       @default(0)
  consultationFee      Float       @default(0)
  emergencyFee         Float       @default(0)
  sugarTestFee         Float       @default(0)
  cancelReason         String?
  treatment            Boolean     @default(false)
  height               Float?
  weight               Float?
  BMI                  Float?
  SPO2                 Float?
  PK                   Float?
  bp                   String?
  sugar                String?
  isTestOnly           Boolean     @default(false)
  emergency            Boolean     @default(false)
  sugerTest            Boolean     @default(false)
  sugerTestQueue       Boolean     @default(false)
  temperature          Float?
  medicineTonic        Boolean     @default(false)
  Injection            Boolean     @default(false)
  scanningTesting      Boolean     @default(false)
  status               Status      @default(PENDING)
  queueStatus          QueueStatus @default(PENDING)
  access               Json?
  createdAt            String?
  updatedAt            String?
  abandonedAt          DateTime?
  paymentStatus        Boolean     @default(false)

  Hospital                  Hospital                    @relation(fields: [hospital_Id], references: [id])
  Patient                   Patient                     @relation(fields: [patient_Id], references: [id])
  Doctor                    Admin                       @relation(fields: [hospital_Id, doctor_Id], references: [hospital_Id, user_Id])
  MedicinePatient           MedicinePatient[]
  Prescription              Prescription[]
  InjectionPatient          InjectionPatient[]
  TonicPatient              TonicPatient[]
  Payment                   Payment[]
  TeatingAndScanningPatient TestingAndScanningPatient[]
}

model Treatment {
  id             Int      @id @default(autoincrement())
  hospital_Id    Int
  staff_Id       Json
  patient_Id     Int
  doctor_Id      Json
  treatmentName  Json?
  startDate      String
  endDate        String
  progress       String?
  treatmentNotes Json?
  status         Status   @default(PENDING)
  createdAt      DateTime @default(now())
  paymentStatus  Boolean  @default(false)
  Hospital       Hospital @relation(fields: [hospital_Id], references: [id])
  Patient        Patient  @relation(fields: [patient_Id], references: [id])
  Doctor         Admin[]  @relation("Doctor_Treatment")
  Staff          Admin[]  @relation("Staff_Treatment")
}

//////////////////////////////////////////////New now create but not use => Medicines, Tonics, Injections /////////////////////////////////////////////////
model Medicines {
  id                     Int       @id @default(autoincrement())
  hospitalId             Int
  name                   String
  code                   String?
  stock                  Int       @default(0) // Current stock quantity
  costPrice              Float // Purchase price per unit
  MRP                    Float // Maximum Retail Price
  sellingPrice           Float? // Selling price after discount
  PTR                    Float? // Price to Retailer
  HSNCode                String? // GST/HSN code
  discountPercent        Float? // Discount offered %
  cgstPercent            Float? // CGST %
  sgstPercent            Float? // SGST %
  freeUnits              Int? // Free units in promotional packs
  producerId             Int? // Link to Manufacturer table
  importerId             Int? // Link to Supplier table
  unit                   String? // Unit type, e.g., tablet, ml
  strength               String? // Strength, e.g., 500mg, 10ml
  batchNumber            String? // Batch or lot number
  expiryDate             DateTime? // Expiry date
  manufacturingDate      DateTime? // Manufacturing date
  minimumStock           Int? // Alert threshold
  reorderLevel           Int? // Automatic reorder trigger
  lastRestockedAt        DateTime? // Track last stock refill
  isPrescriptionRequired Boolean   @default(false) // Flag if prescription is required
  isActive               Boolean   @default(true) // Active/Inactive medicine
  storageCondition       String? // Storage instructions
  notes                  String? // Additional information for pharmacists
  barcode                String?   @unique
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // Relations
  staffIds             Json? // Array/object of staff handling the medicine
  Hospital             Hospital              @relation(fields: [hospitalId], references: [id])
  manufacturer         Manufacturer?         @relation("MedicineManufacturer", fields: [producerId], references: [id])
  importer             Supplier?             @relation("MedicineSupplier", fields: [importerId], references: [id])
  //medicinePatients       MedicinePatient[]
  medicineTransactions MedicineTransaction[] // Log of stock in/out
  //MedicineAndInjection   MedicineAndInjection[]     @relation("MedicineAndInjection_Medicine")

  @@unique([hospitalId, code])
}

model MedicineTransaction {
  id          Int       @id @default(autoincrement())
  medicineId  Int
  type        String // 'IN', 'OUT', 'GIVEAWAY', 'SALE', 'RETURN'
  packType    String? // e.g., "10 tablets"
  quantity    Int
  description String?
  staffId     Int?
  createdAt   DateTime  @default(now())
  medicine    Medicines @relation(fields: [medicineId], references: [id])
}

model Tonics {
  id                     Int       @id @default(autoincrement())
  hospital_Id            Int
  name                   String
  code                   String?
  stock                  Json? // { "250ml": 50, "500ml": 30 }
  packSize               Json? // { "250ml": 250, "500ml": 500 } volume per pack
  freeUnits              Json? // { "250ml": 50, "500ml": 0 } extra ml per pack
  costPrice              Json?
  MRP                    Json?
  PTR                    Json?
  sellingPrice           Json?
  discountPercent        Float?
  HSNCode                String?
  cgstPercent            Float?
  sgstPercent            Float?
  producerId             Int?
  importerId             Int?
  batchNumber            String?
  expiryDate             DateTime?
  manufacturingDate      DateTime?
  minimumStock           Json?
  reorderLevel           Json?
  isPrescriptionRequired Boolean   @default(false)
  isActive               Boolean   @default(true)
  storageCondition       String?
  notes                  String?
  staffIds               Json?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @default(now())

  Hospital     Hospital      @relation(fields: [hospital_Id], references: [id])
  manufacturer Manufacturer? @relation("TonicManufacturer", fields: [producerId], references: [id])
  importer     Supplier?     @relation("TonicSupplier", fields: [importerId], references: [id])

  tonicTransactions TonicTransaction[]

  @@unique([hospital_Id, code])
}

model TonicTransaction {
  id          Int      @id @default(autoincrement())
  tonicId     Int
  type        String // 'IN', 'OUT', 'GIVEAWAY', 'SALE', 'RETURN'
  packType    String? // e.g., "250ml"
  quantity    Int
  description String?
  staffId     Int?
  createdAt   DateTime @default(now())
  tonic       Tonics   @relation(fields: [tonicId], references: [id])
}

model Injections {
  id                     Int       @id @default(autoincrement())
  hospital_Id            Int
  name                   String
  code                   String?
  stock                  Json? // { "1ml": 50, "2ml": 30 }
  packSize               Json? // volume per pack
  freeUnits              Json?
  costPrice              Json?
  MRP                    Json?
  PTR                    Json?
  sellingPrice           Json?
  discountPercent        Float?
  HSNCode                String?
  cgstPercent            Float?
  sgstPercent            Float?
  producerId             Int?
  importerId             Int?
  batchNumber            String?
  expiryDate             DateTime?
  manufacturingDate      DateTime?
  minimumStock           Json?
  reorderLevel           Json?
  isPrescriptionRequired Boolean   @default(false)
  isActive               Boolean   @default(true)
  storageCondition       String?
  notes                  String?
  staffIds               Json?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @default(now())

  // Relations
  Hospital              Hospital               @relation(fields: [hospital_Id], references: [id])
  manufacturer          Manufacturer?          @relation("InjectionManufacturer", fields: [producerId], references: [id])
  importer              Supplier?              @relation("InjectionSupplier", fields: [importerId], references: [id])
  injectionTransactions InjectionTransaction[]

  @@unique([hospital_Id, code])
}

model InjectionTransaction {
  id          Int        @id @default(autoincrement())
  injectionId Int
  type        String // 'IN', 'OUT', 'GIVEAWAY', 'SALE', 'RETURN'
  packType    String? // e.g., "1ml"
  quantity    Int
  description String?
  staffId     Int?
  createdAt   DateTime   @default(now())
  injection   Injections @relation(fields: [injectionId], references: [id])
}

model Manufacturer {
  id        Int      @id @default(autoincrement())
  name      String
  contact   String?
  country   String?
  category  String // 'Medicine', 'Tonic', 'Injection'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  medicines  Medicines[]  @relation("MedicineManufacturer")
  tonics     Tonics[]     @relation("TonicManufacturer")
  injections Injections[] @relation("InjectionManufacturer")
}

model Supplier {
  id        Int      @id @default(autoincrement())
  name      String
  contact   String?
  country   String?
  category  String // 'Medicine', 'Tonic', 'Injection'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  medicines  Medicines[]  @relation("MedicineSupplier")
  tonics     Tonics[]     @relation("TonicSupplier")
  injections Injections[] @relation("InjectionSupplier")
}

