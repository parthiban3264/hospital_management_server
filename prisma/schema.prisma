enum PaymentType {
  ManualPay
  OnlinePay
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum Type {
  REGISTRATIONFEE
  TESTINGFEESANDSCANNINGFEE
  TREATMENTFEE
  MEDICINEFEEANDINJECTIONFEE
  MEDICINETONICINJECTIONFEES
  ROOMCHARGE
  OTHER
}

