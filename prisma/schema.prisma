enum Status {
  SCHEDULED
  COMPLETED
  CANCELLED
  ONGOING
  PENDING
}

model Consultation {
  id                Int      @id @default(autoincrement())
  hospital_Id       Int
  patient_Id        String
  doctor_Id         String
  appointdate       String? //Appoint time
  purpose           String
  temperature       Float
  symptoms          String
  notes             Json?
  diagnosis         String?
  treatment         Boolean  @default(false)
  medicineInjection Boolean  @default(false)
  scanningTesting   Boolean  @default(false)
  status            Status @default(PENDING) 
  access            Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  paymentStatus     Boolean  @default(false)

  Hospital Hospital @relation(fields: [hospital_Id], references: [id])
  Patient  Patient  @relation(fields: [hospital_Id, patient_Id], references: [hospital_Id, user_Id])
  Doctor   Admin    @relation(fields: [hospital_Id, doctor_Id], references: [hospital_Id, user_Id])
}



model Treatment {
  id            Int      @id @default(autoincrement())
  hospital_Id   Int
  staff_Id      Json // Array/object
  patient_Id    String
  doctor_Id     Json // Array/object
  treatmentName Json? // Array/object
  startDate     String
  endDate       String
  progress      String?
  treatmentNotes Json?
  status        Status @default(PENDING) 
  createdAt     DateTime @default(now())
  paymentStatus Boolean  @default(false)
  Hospital      Hospital @relation(fields: [hospital_Id], references: [id])
  Patient       Patient  @relation(fields: [hospital_Id, patient_Id], references: [hospital_Id, user_Id])
  Doctor        Admin[]  @relation("Doctor_Treatment")
  Staff         Admin[]  @relation("Staff_Treatment")
}

model Medician {
  id                   Int                    @id @default(autoincrement())
  hospital_Id          Int
  medicianName         String
  stock                Int
  amount               Float
  staff_Id             Json // Array/object
  MedicineAndInjection MedicineAndInjection[] @relation("MedicineAndInjection_Medician")
  Hospital             Hospital               @relation(fields: [hospital_Id], references: [id])
}

model Injection {
  id                   Int                    @id @default(autoincrement())
  hospital_Id          Int
  injectionName        String
  stock                Int
  amount               Float
  staff_Id             Json // Array/object
  MedicineAndInjection MedicineAndInjection[] @relation("Injection_MedicineAndInjection")
  Hospital             Hospital               @relation(fields: [hospital_Id], references: [id])
}

model TestingAndScanningHospital {
  id          Int      @id @default(autoincrement())
  hospital_Id Int
  type        String // consider enum if limited set
  status      String // consider enum
  roomNo      String
  staff_Id    Int
  amount      Float
  Hospital    Hospital @relation(fields: [hospital_Id], references: [id])
}

model MedicineAndInjection {
  id          Int    @id @default(autoincrement())
  hospital_Id Int
  patient_Id  String
  doctor_Id   Json // Array/object
  staff_Id    Json // Array/object

  medicine_Id       Json? // Array/object
  dosageMedicine    Json?
  medicineNotes     Json?
  frequencyMedicine Json?
  durationMedicine  String?
  medicineStatus    Boolean @default(false) // consider enum

  injection_Id       Json?
  dosageInjection    Json?
  InjectionNotes     Json?
  frequencyInjection Json?
  durationInjection  String?
  injectionStatus    Boolean     @default(false)

  status        Status      @default(PENDING) // consider enum
  paymentStatus      Boolean     @default(false)
  createdAt          DateTime    @default(now())
  Hospital           Hospital    @relation(fields: [hospital_Id], references: [id])
  Patient            Patient     @relation("Patient_MedicineAndInjection", fields: [patient_Id, hospital_Id], references: [user_Id, hospital_Id])
  Medician           Medician[]  @relation("MedicineAndInjection_Medician")
  Injection          Injection[] @relation("Injection_MedicineAndInjection")
}

enum TestingAndScanningStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  PENDING
}

model TestingAndScanningPatient {
  id            Int                      @id @default(autoincrement())
  hospital_Id   Int
  patient_Id    String
  doctor_Id     Json
  staff_Id      Json?
  title         String
  scheduleDate  DateTime
  type          String
  status        TestingAndScanningStatus @default(PENDING) // consider enum
  paymentStatus Boolean                  @default(false)
  result        String?
  createdAt     DateTime                 @default(now())
  Hospital      Hospital                 @relation(fields: [hospital_Id], references: [id])
  Patient       Patient                  @relation(fields: [patient_Id, hospital_Id], references: [user_Id, hospital_Id])
}

enum PaymentType {
  manual
  InstantPay
  FinalPay
}

enum PaymentReason {
  Consultation
  Treatment
  Medicine
  Injection
  Testing
  Scanning
  Other
}

model Payment {
  id            Int           @id @default(autoincrement())
  hospital_Id   Int
  patient_Id    String
  reason        PaymentReason
  status        PaymentStatus
  amount        Float
  type          PaymentType
  transactionId Json
  billingId     String?
  createdBy     String?
  updategdBy    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  Hospital      Hospital      @relation(fields: [hospital_Id], references: [id])
  Patient       Patient       @relation(fields: [patient_Id, hospital_Id], references: [user_Id, hospital_Id])
}

model RoomsAvailable {
  id          Int      @id @default(autoincrement())
  hospital_Id Int
  staff_Id    String
  roomNo      String
  capacity    Int
  notes       String
  type        String // consider enum if limited set // e.g., ICU, General, Private
  amount      Float
  Hospital    Hospital @relation(fields: [hospital_Id], references: [id])
}

model Fees{
  id Int @id @default(autoincrement())
  hospital_Id Int
  type Float?
  amount Float ?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Hospital Hospital @relation(fields: [hospital_Id], references: [id])
}
