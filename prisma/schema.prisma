//   updatedAt DateTime @updatedAt
// }

enum AdmissionStatus {
  ADMITTED
  COMPLETED
  DISCHARGED
  CANCELLED
}

enum ChargeStatus {
  PENDING
  PAID
  CANCELLED
}

model Charge {
  id          Int          @id @default(autoincrement())
  admissionId Int
  admission   Admission    @relation(fields: [admissionId], references: [id])
  description String
  chargeDate  DateTime?    // 👈 VERY IMPORTANT (billing day)
  amount      Float
  status      ChargeStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

//////new medicine all in one table --------------------------------

enum StockMovementType {
  IN
  OUT
  RETURN
}

model Medicine {
  id          Int      @id @default(autoincrement())
  hospital_Id Int
  name        String
  category    String
  stock       Int
  ndc_code    String?
  reorder     Int?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())

  hospital              Hospital               @relation(fields: [hospital_Id], references: [id])
  batches               MedicineBatch[]
  //billItems BillItem[]
  prescriptionMedicines PrescriptionMedicine[]
  prescriptionDispenses PrescriptionDispense[]
}

model MedicineBatch {
  id                      Int      @id @default(autoincrement())
  hospital_Id             Int
  medicine_id             Int
  HSN                     String?
  batch_no                String
  expiry_date             DateTime
  manufacture_date        DateTime
  total_stock             Int?
  total_quantity          Int?
  quantity                Int
  free_quantity           Int?
  unit                    Int
  rack_no                 String?
  mrp                     Float?
  profit                  Float?
  purchase_price_unit     Float
  purchase_price_quantity Float
  selling_price_quantity  Float
  selling_price_unit      Float
  purchase_details        Json?
  supplier_id             Int? // ✅ THIS WAS MISSING
  is_active               Boolean  @default(true)
  created_at              DateTime @default(now())

  hospital Hospital   @relation(fields: [hospital_Id], references: [id])
  medicine Medicine   @relation(fields: [medicine_id], references: [id])
  supplier Suppliers? @relation(fields: [supplier_id], references: [id])

  movements             StockMovement[]
  prescriptionDispenses PrescriptionDispense[]

  @@unique([hospital_Id, medicine_id, batch_no])
}

model StockMovement {
  id            Int               @id @default(autoincrement())
  hospital_Id   Int
  batch_id      Int
  movement_type StockMovementType
  quantity      Int
  reason        String
  reference     String?
  movement_date DateTime          @default(now())

  hospital Hospital @relation(fields: [hospital_Id], references: [id])

  batch MedicineBatch @relation(fields: [batch_id], references: [id])
}

model Suppliers {
  id          Int             @id @default(autoincrement())
  hospital_Id Int
  name        String
  phone       String
  email       String?
  address     String?
  is_active   Boolean         @default(true)
  created_at  DateTime        @default(now())
  batches     MedicineBatch[]

  @@unique([hospital_Id, name, phone])
}

enum PrescriptionStatus {
  DRAFT
  SIGNED
  PARTIALLY_DISPENSED
  DISPENSED
  CANCELLED
}

enum MedicineRoute {
  TABLET
  INJECTION
  SYRUP
  DROP
  OINTMENT
  CREAM
  SOAP
  OTHER
}

enum MedicineStatus {
  PENDING
  CANCELLED
  COMPLETED
  ONGOING
}

model Prescription {
  id              Int    @id @default(autoincrement())
  hospital_Id     Int
  prescription_no String @unique
  patient_Id      Int
  doctor_Id       String
  consultation_Id Int?
  payment_Id      Int?

  status         PrescriptionStatus @default(DRAFT)
  notes          String?
  follow_up_date DateTime?
  valid_till     DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  is_active  Boolean  @default(true)

  hospital     Hospital      @relation(fields: [hospital_Id], references: [id])
  patient      Patient       @relation(fields: [patient_Id], references: [id])
  doctor       Admin         @relation(fields: [doctor_Id, hospital_Id], references: [user_Id, hospital_Id])
  consultation Consultation? @relation(fields: [consultation_Id], references: [id])
  payment      Payment?      @relation(fields: [payment_Id], references: [id])

  medicines PrescriptionMedicine[]
}

model PrescriptionMedicine {
  id              Int @id @default(autoincrement())
  prescription_Id Int
  medicine_Id     Int

  dosage             String?
  route              MedicineRoute
  frequency          String?
  days               Int
  total_quantity     Int
  dispensed_quantity Int           @default(0)

  after_food Boolean @default(false)
  morning    Boolean @default(false)
  afternoon  Boolean @default(false)
  night      Boolean @default(false)

  instructions String?
  status       MedicineStatus @default(PENDING)

  created_at DateTime @default(now())

  prescription Prescription @relation(fields: [prescription_Id], references: [id])
  medicine     Medicine     @relation(fields: [medicine_Id], references: [id])

  dispenses PrescriptionDispense[]

  @@unique([prescription_Id, medicine_Id])
}

model PrescriptionDispense {
  id                       Int      @id @default(autoincrement())
  hospital_Id              Int
  prescription_medicine_Id Int
  medicine_Id              Int
  batch_Id                 Int
  amount                   Int?
  dispensed_quantity       Int
  dispensed_by             Int
  dispensed_at             DateTime @default(now())

  hospital Hospital @relation(fields: [hospital_Id], references: [id])

  prescriptionMedicine PrescriptionMedicine @relation(fields: [prescription_medicine_Id], references: [id])

  medicine Medicine      @relation(fields: [medicine_Id], references: [id])
  batch    MedicineBatch @relation(fields: [batch_Id], references: [id])
}

