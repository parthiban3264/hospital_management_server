model ScanAndTests {
  id          Int     @id @default(autoincrement())
  hospital_Id Int
  title       String
  type        Types
  amount      Float?
  createdAt   String?
  updatedAt   String?

  hospital Hospital            @relation(fields: [hospital_Id], references: [id])
  options  ScanAndTestOption[]

  @@unique([hospital_Id, title, type])
  @@index([hospital_Id])
}

model ScanAndTestOption {
  id         Int    @id @default(autoincrement())
  scanTestId Int
  optionName String
  price      Float?

  scanTest ScanAndTests             @relation(fields: [scanTestId], references: [id])
  unitRef  ScanAndTestUnitReference @relation(fields: [optionName], references: [optionName])

  @@unique([scanTestId, optionName])
  @@index([scanTestId])
  @@index([optionName])
}

// model ScanAndTestUnitReference {
//   id         Int      @id @default(autoincrement())
//   optionName String   @unique
//   unit       String
//   reference  Json
//   createdAt  DateTime @default(now())
//   updatedAt  DateTime @updatedAt

//   options ScanAndTestOption[]
// }

model ScanAndTestUnitReference {
  id          Int      @id @default(autoincrement())
  optionName  String   @unique
  optionTitle String
  type        String?
  unit        String
  reference   Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  options ScanAndTestOption[]
}

model ScanAndTestUnitReferance {
  id          Int      @id @default(autoincrement())
  optionName  String   @unique // e.g. "Hemoglobin", "ALT", "Creatinine"
  optionTitle String // e.g. "Hemoglobin (Hb)", "Alanine Aminotransferase (ALT)", "Creatinine"
  unit        String // e.g. "g/dL", "mg/dL", "U/L"
  referance   Json // JSON of ranges (age/gender/pregnancy keys)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Drawer {
  id          Int      @id @default(autoincrement())
  hospital_Id Int
  admin_Id    String?
  reason      String
  amount      Float
  type        String
  note        String?
  createdAt   String
  updatedAt   String?
  Hospital    Hospital @relation(fields: [hospital_Id], references: [id])
}

model IncomeAndExpense {
  id          Int      @id @default(autoincrement())
  hospital_Id Int
  admin_Id    String?
  reason      String
  amount      Float
  type        String
  note        String?
  createdAt   String
  updatedAt   String?
  Hospital    Hospital @relation(fields: [hospital_Id], references: [id])
}

model MedicineProgress {
  id                Int      @id @default(autoincrement())
  medicinePatientId Int
  date              DateTime
  morningTaken      Boolean  @default(false)
  afternoonTaken    Boolean  @default(false)
  nightTaken        Boolean  @default(false)

  morningEmailSent   Boolean @default(false)
  afternoonEmailSent Boolean @default(false)
  nightEmailSent     Boolean @default(false)

  MedicinePatient MedicinePatient @relation(fields: [medicinePatientId], references: [id])

  @@index([medicinePatientId])
}

model TonicProgress {
  id             Int      @id @default(autoincrement())
  tonicPatientId Int
  date           DateTime
  morningTaken   Boolean  @default(false)
  afternoonTaken Boolean  @default(false)
  nightTaken     Boolean  @default(false)

  morningEmailSent   Boolean @default(false)
  afternoonEmailSent Boolean @default(false)
  nightEmailSent     Boolean @default(false)

  TonicPatient TonicPatient @relation(fields: [tonicPatientId], references: [id])

  @@index([tonicPatientId])
}

model InjectionProgress {
  id                 Int      @id @default(autoincrement())
  injectionPatientId Int
  date               DateTime
  morningTaken       Boolean  @default(false)
  afternoonTaken     Boolean  @default(false)
  nightTaken         Boolean  @default(false)

  morningEmailSent   Boolean @default(false)
  afternoonEmailSent Boolean @default(false)
  nightEmailSent     Boolean @default(false)

  InjectionPatient InjectionPatient @relation(fields: [injectionPatientId], references: [id])

  @@index([injectionPatientId])
}

model Tickets {
  id          Int      @id @default(autoincrement())
  hospital_Id Int
  admin_Id    String
  title       String
  description String
  status      Status
  createdAt   String
  updatedAt   String?
  Hospital    Hospital @relation(fields: [hospital_Id], references: [id])
}
