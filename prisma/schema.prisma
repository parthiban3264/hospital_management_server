generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  // url      = "mysql://root:pass%403264@localhost:3306/hospital_management"
  url      = "mysql://schoolAttendance:Sensarsoft%40123@[2a02:4780:12:f6a7::1]:3306/hospital_management"
}

enum HospitalStatus {
  ACTIVE
  INACTIVE
}

enum AdminStatus {
  ACTIVE
  INACTIVE
}

enum PatientStatus {
  ACTIVE
  INACTIVE
}

model Hospital {
  id                    Int       @id//@default(autoincrement())   @unique          //  @default(autoincrement())
  name                  String
  address               String
  photo                 String @default("https://img.freepik.com/premium-vector/hospital-logo-design-vector-illustration-white-background_272204-8968.jpg?w=2000")
  HospitalStatus        HospitalStatus               @default(ACTIVE)
  phone                 String
  mail                  String
  Users                 User[]
  Admins                Admin[]
  Patients              Patient[]
  Consultation          Consultation[]
  Treatments            Treatment[]
  Medicians             Medician[]
  Injections            Injection[]
  Tonics                Tonic[]
  TestingAndScannings   TestingAndScanningPatient[]
  TestingAndScanningHs  TestingAndScanningHospital[]
  RoomsAvailables       RoomsAvailable[]
  Payments              Payment[]
  MedicineAndInjections MedicineAndInjection[]
  Fees                  Fees[]
  MedicinePatients      MedicinePatient[]
  InjectionPatients     InjectionPatient[]
  TonicPatients         TonicPatient[]
  ScanAndTests          ScanAndTest[]
  Drawers               Drawer[]
  IncomeAndExpenses     IncomeAndExpense[]
}

model User {
  id           Int            @id @default(autoincrement())
  hospital_Id  Int
  user_Id      String         @unique
  password     String
  role         String
  AdminStrator AdminStrator[]
  Admin        Admin[]
  Patient      Patient[]
  Hospital     Hospital       @relation(fields: [hospital_Id], references: [id])

  @@unique([hospital_Id, user_Id])
}

model Admin {
  id           Int            @id @default(autoincrement())
  hospital_Id  Int
  user_Id      String
  name         String
  designation  String?
  role         String // e.g., Doctor, Nurse, Admin
  specialist   String?
  phone        String
  email        String
  address      String
  photo        String?        @default("https://cdn-icons-png.flaticon.com/512/387/387561.png")
  status       AdminStatus    @default(ACTIVE)
  gender       String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  Consultation Consultation[]
  Doctor       Treatment[]    @relation("Doctor_Treatment")
  Staff        Treatment[]    @relation("Staff_Treatment")
  Hospital     Hospital       @relation(fields: [hospital_Id], references: [id])
  User         User           @relation(fields: [hospital_Id, user_Id], references: [hospital_Id, user_Id])

  @@unique([hospital_Id, user_Id])
}

model AdminStrator {
  id          Int     @id @default(autoincrement())
  user_Id     String
  name        String
  status      String
  role        String
  designation String? // was 'destination'
  phone       String
  email       String
  photo       String? @default("https://img.freepik.com/premium-vector/technology-concept-vector-illustration-featuring-consulting-design-flat-style-elements_1226483-4088.jpg?semt=ais_hybrid&w=740&q=80")
  address     String
  gender      String
  User        User    @relation(fields: [user_Id], references: [user_Id])

  @@map("administrator")
}

model Patient {
  id             Int           @id @default(autoincrement())
  hospital_Id    Int
  user_Id        String
  staff_Id       String
  name           String
  ac_name        String?
  phone          Json
  email          Json
  photo          String?       @default("null")
  status         PatientStatus @default(ACTIVE)
  address        Json?
  dob            DateTime
  gender         String?
  bldGrp         String?
  currentProblem String?
  medicalHistory String?
  tempCreatedAt  DateTime?
  createdAt      String?
  updatedAt      String?

  Consultation         Consultation[]
  Treatment            Treatment[]
  MedicineAndInjection MedicineAndInjection[]      @relation("Patient_MedicineAndInjection")
  TestingAndScanning   TestingAndScanningPatient[]
  Payments             Payment[]
  MedicinePatients     MedicinePatient[]
  InjectionPatients    InjectionPatient[]
  TonicPatients        TonicPatient[]

  Hospital Hospital @relation(fields: [hospital_Id], references: [id])
  User     User     @relation(fields: [hospital_Id, user_Id], references: [hospital_Id, user_Id])

  @@unique([hospital_Id, user_Id])
}

enum Status {
  SCHEDULED
  COMPLETED
  CANCELLED
  ENDPROCESS
  ENDPROCESSING
  ONGOING
  PENDING
}

enum QueueStatus {
  PENDING
  ONGOING
  DRQUEUE
  COMPLETED
}

model Consultation {
  id              Int         @id @default(autoincrement())
  hospital_Id     Int
  patient_Id      String
  doctor_Id       String
  // appointdate       String? //Appoint time
  purpose         String
  symptoms        Boolean     @default(false)
  notes           Json?
  // diagnosis         String?
  treatment       Boolean     @default(false)
  height          Float?
  weight          Float?
  bp              String?
  sugar           String?
  temperature     Float?
  medicineTonic   Boolean     @default(false)
  Injection       Boolean     @default(false)
  scanningTesting Boolean     @default(false)
  status          Status      @default(PENDING)
  queueStatus     QueueStatus @default(PENDING)
  access          Json?
  createdAt       String?
  updatedAt       String?
  paymentStatus   Boolean     @default(false)

  Hospital                  Hospital                    @relation(fields: [hospital_Id], references: [id])
  Patient                   Patient                     @relation(fields: [hospital_Id, patient_Id], references: [hospital_Id, user_Id])
  Doctor                    Admin                       @relation(fields: [hospital_Id, doctor_Id], references: [hospital_Id, user_Id])
  MedicinePatient           MedicinePatient[]
  InjectionPatient          InjectionPatient[]
  TonicPatient              TonicPatient[]
  Payment                   Payment[]
  TeatingAndScanningPatient TestingAndScanningPatient[]
}

model Treatment {
  id             Int      @id @default(autoincrement())
  hospital_Id    Int
  staff_Id       Json // Array/object
  patient_Id     String
  doctor_Id      Json // Array/object
  treatmentName  Json? // Array/object
  startDate      String
  endDate        String
  progress       String?
  treatmentNotes Json?
  status         Status   @default(PENDING)
  createdAt      DateTime @default(now())
  paymentStatus  Boolean  @default(false)
  Hospital       Hospital @relation(fields: [hospital_Id], references: [id])
  Patient        Patient  @relation(fields: [hospital_Id, patient_Id], references: [hospital_Id, user_Id])
  Doctor         Admin[]  @relation("Doctor_Treatment")
  Staff          Admin[]  @relation("Staff_Treatment")
}

model Medician {
  id                   Int                    @id @default(autoincrement())
  hospital_Id          Int
  medicianName         String
  medicianCode         String?
  stock                Int?
  amount               Float
  expiryDate           String?
  manifacturingDate    String?
  staff_Id             Json? // Array/object
  MedicineAndInjection MedicineAndInjection[] @relation("MedicineAndInjection_Medician")
  Hospital             Hospital               @relation(fields: [hospital_Id], references: [id])
  MedicinePatients     MedicinePatient[]
}

// @@unique([medicianName, hospital_Id])
model Tonic {
  id                   Int                    @id @default(autoincrement())
  hospital_Id          Int
  tonicName            String
  tonicCode            String?
  stock                Json? // Quantity 250ml=stack=50, 500ml etc. 100ml=50
  amount               Json?
  staff_Id             Json? // Array/object
  expiryDate           String?
  manifacturingDate    String?
  MedicineAndInjection MedicineAndInjection[] @relation("Tonic_MedicineAndInjection")
  Hospital             Hospital               @relation(fields: [hospital_Id], references: [id])
  TonicPatients        TonicPatient[]
}

model Injection {
  id                   Int                    @id @default(autoincrement())
  hospital_Id          Int
  injectionName        String
  injectionCode        String?
  stock                Json?
  unit                 String? // ✅ Added: mg, mL
  amount               Json?
  expiryDate           String?
  manifacturingDate    String?
  staff_Id             Json? // Array/object
  MedicineAndInjection MedicineAndInjection[] @relation("Injection_MedicineAndInjection")
  Hospital             Hospital               @relation(fields: [hospital_Id], references: [id])
  InjectionPatients    InjectionPatient[]
}

model TestingAndScanningHospital {
  id          Int      @id @default(autoincrement())
  hospital_Id Int
  type        String // consider enum if limited set
  status      String // consider enum
  roomNo      String
  staff_Id    Int
  amount      Float
  Hospital    Hospital @relation(fields: [hospital_Id], references: [id])
}

model MedicineAndInjection {
  id          Int    @id @default(autoincrement())
  hospital_Id Int
  patient_Id  String
  doctor_Id   Json // Array/object
  staff_Id    Json? // Array/object

  medicine_Id       Json? // Array/object
  dosageMedicine    Json?
  medicineNotes     Json?
  frequencyMedicine Json?
  durationMedicine  Json?
  medicineStatus    Boolean @default(false) // consider enum

  injection_Id       Json?
  dosageInjection    Json?
  InjectionNotes     Json?
  frequencyInjection Json?
  durationInjection  Json?
  injectionStatus    Boolean @default(false)

  status        Status      @default(PENDING) // consider enum
  paymentStatus Boolean     @default(false)
  createdAt     DateTime    @default(now())
  Hospital      Hospital    @relation(fields: [hospital_Id], references: [id])
  Patient       Patient     @relation("Patient_MedicineAndInjection", fields: [patient_Id, hospital_Id], references: [user_Id, hospital_Id])
  Medician      Medician[]  @relation("MedicineAndInjection_Medician")
  Injection     Injection[] @relation("Injection_MedicineAndInjection")
  Tonic         Tonic[]     @relation("Tonic_MedicineAndInjection")
}

enum TestingAndScanningStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  PENDING
}

