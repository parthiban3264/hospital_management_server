model TestingAndScanningPatient {
  id                    Int                      @id @default(autoincrement())
  hospital_Id           Int
  patient_Id            String
  doctor_Id             Json
  staff_Id              Json?
  title                 String?
  scheduleDate          DateTime
  queueStatus           QueueStatus              @default(PENDING)
  selectedOptions       Json?
  selectedOptionResults Json?
  type                  String?
  status                TestingAndScanningStatus @default(PENDING)
  paymentStatus         Boolean                  @default(false)
  amount                Float?
  reason                String?
  result                String?
  createdAt             String
  updatedAt             String?
  consultation_Id       Int?
  payment_Id            Int? // link to Payment
  Payment               Payment?                 @relation(fields: [payment_Id], references: [id])
  Hospital              Hospital                 @relation(fields: [hospital_Id], references: [id])
  Patient               Patient                  @relation(fields: [patient_Id, hospital_Id], references: [user_Id, hospital_Id])
  Consultation          Consultation?            @relation(fields: [consultation_Id], references: [id])
}

model ScanAndTest {
  id          Int      @id @default(autoincrement())
  hospital_Id Int
  title       String
  options     Json? // list of sub-tests [{ name, price }]
  type        Types
  amount      Float?
  createdAt   String?
  updatedAt   String?
  Hospital    Hospital @relation(fields: [hospital_Id], references: [id])
}

model ScanAndTestUnitReferance {
  id         Int      @id @default(autoincrement())
  optionName String   @unique // e.g. "Hemoglobin", "ALT", "Creatinine"
  unit       String // e.g. "g/dL", "mg/dL", "U/L"
  referance  Json // JSON of ranges (age/gender/pregnancy keys)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Drawer {
  id          Int      @id @default(autoincrement())
  hospital_Id Int
  admin_Id    String?
  reason      String
  amount      Float
  type        String
  note        String?
  createdAt   String
  updatedAt   String?
  Hospital    Hospital @relation(fields: [hospital_Id], references: [id])
}

model IncomeAndExpense {
  id          Int      @id @default(autoincrement())
  hospital_Id Int
  admin_Id    String?
  reason      String
  amount      Float
  type        String
  note        String?
  createdAt   String
  updatedAt   String?
  Hospital    Hospital @relation(fields: [hospital_Id], references: [id])
}
