  discountPercent        Float?
  HSNCode                String?
  cgstPercent            Float?
  sgstPercent            Float?
  producerId             Int?
  importerId             Int?
  batchNumber            String?
  expiryDate             DateTime?
  manufacturingDate      DateTime?
  minimumStock           Json?
  reorderLevel           Json?
  isPrescriptionRequired Boolean   @default(false)
  isActive               Boolean   @default(true)
