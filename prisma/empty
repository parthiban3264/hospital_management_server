model User {
  id           Int       @id @default(autoincrement())
  hospital_Id  Int
  user_Id      String
  password     String
  role         String
  device_Id    String?   @db.Text
  sessionToken String?   @db.Text
  isLoggedIn   Boolean   @default(false)
  Admin        Admin[]
  Patient      Patient[]
  Hospital     Hospital  @relation(fields: [hospital_Id], references: [id])

  @@unique([hospital_Id, user_Id])
}

model Admin {
  id               Int            @id @default(autoincrement())
  hospital_Id      Int
  user_Id          String
  name             String
  designation      String?
  role             String // e.g., Doctor, Nurse, Admin
  accessDoctorRole Boolean        @default(false) // e.g., General Physician, Cardiologist, etc.
  accessAdminRole  Boolean        @default(false) // e.g., Super Admin, Finance Admin, etc.
  doctorAmount     Float?         @default(0)
  specialist       String?
  assignDoctorId   String? // for Nurse/Staff to assign Doctor
  permissions      Json? // store [1,2,3] etc for Medical Staff; keep NULL for ADMIN
  phone            String
  email            String
  address          String
  photo            String?        @default("https://as2.ftcdn.net/v2/jpg/05/89/93/27/1000_F_589932782_vQAEAZhHnq1QCGu5ikwrYaQD0Mmurm0N.jpg")
  status           AdminStatus    @default(ACTIVE)
  gender           String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  Consultation     Consultation[]
  Doctor           Treatment[]    @relation("Doctor_Treatment")
  Staff            Treatment[]    @relation("Staff_Treatment")
  Hospital         Hospital       @relation(fields: [hospital_Id], references: [id])
  User             User           @relation(fields: [hospital_Id, user_Id], references: [hospital_Id, user_Id])

  @@unique([hospital_Id, user_Id])
}

model ButtonPermissions {
  id          Int    @id @default(autoincrement())
