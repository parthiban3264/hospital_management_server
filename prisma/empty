  consultation_Id Int?
  reason          String?
  quantity        Int
  Doase           String?
  morning         Boolean @default(false)
  afternoon       Boolean @default(false)
  night           Boolean @default(false)
  days            Int?    @default(0)
  status          Status  @default(PENDING)
  total           Float?
  paymentStatus   Boolean @default(false)
  createdAt       String?
  updatedAt       String?

  payment_Id        Int?
  Payment           Payment?            @relation(fields: [payment_Id], references: [id])
  Hospital          Hospital            @relation(fields: [hospital_Id], references: [id])
  Patient           Patient             @relation(fields: [patient_Id], references: [id])
  Injection         Injection           @relation(fields: [injection_Id], references: [id])
  Consultation      Consultation?       @relation(fields: [consultation_Id], references: [id])
  InjectionProgress InjectionProgress[]
}

model TonicPatient {
  id              Int     @id @default(autoincrement())
  hospital_Id     Int
  patient_Id      Int
  doctor_Id       String
  tonic_Id        Int
  consultation_Id Int?
  reason          String?
  quantity        Int
  reduceQuantity  Float?
  Doase           String?
  afterEat        Boolean
  morning         Boolean @default(false)
  afternoon       Boolean @default(false)
  night           Boolean @default(false)
  days            Int     @default(0)
  total           Float?
  status          Status  @default(PENDING)
  paymentStatus   Boolean @default(false)
  createdAt       String?
  updatedAt       String?

  payment_Id    Int?
  Payment       Payment?        @relation(fields: [payment_Id], references: [id])
  Hospital      Hospital        @relation(fields: [hospital_Id], references: [id])
  Patient       Patient         @relation(fields: [patient_Id], references: [id])
  Tonic         Tonic           @relation(fields: [tonic_Id], references: [id])
  Consultation  Consultation?   @relation(fields: [consultation_Id], references: [id])
  TonicProgress TonicProgress[]
}

model cosmetic {
  id          Int      @id @default(autoincrement())
  hospital_Id Int
  name        String
  type        String? // consider enum if limited set
  unit        String?
  imageUrl    String?  @db.Text
  stock       Int      @default(0)
  amount      Float
  staff_Id    Int
  Hospital    Hospital @relation(fields: [hospital_Id], references: [id])
}

model TestingAndScanningHospital {
  id          Int      @id @default(autoincrement())
  hospital_Id Int
  type        String // consider enum if limited set
  status      String // consider enum
  roomNo      String
  staff_Id    Int
  amount      Float
  Hospital    Hospital @relation(fields: [hospital_Id], references: [id])
}

model ScanAndTest {
  id          Int      @id @default(autoincrement())
  hospital_Id Int
  title       String
  options     Json? // list of sub-tests [{ name, price }]
  type        Types
  amount      Float?
  createdAt   String?
  updatedAt   String?
  Hospital    Hospital @relation(fields: [hospital_Id], references: [id])
}

model ScanAndTestUnitReferance {
  id          Int      @id @default(autoincrement())
  optionName  String   @unique // e.g. "Hemoglobin", "ALT", "Creatinine"
  optionTitle String // e.g. "Hemoglobin (Hb)", "Alanine Aminotransferase (ALT)", "Creatinine"
  unit        String // e.g. "g/dL", "mg/dL", "U/L"
  referance   Json // JSON of ranges (age/gender/pregnancy keys)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
