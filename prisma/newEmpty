generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = "mysql://schoolAttendance:Sensarsoft%40123@[2a02:4780:12:f6a7::1]:3306/hospital_management"
}

enum HospitalStatus {
  ACTIVE
  INACTIVE
}

enum AdminStatus {
  ACTIVE
  INACTIVE
}

enum PatientStatus {
  ACTIVE
  INACTIVE
}

enum Status {
  SCHEDULED
  COMPLETED
  CANCELLED
  ENDPROCESS
  ENDPROCESSING
  ONGOING
  PENDING
}

enum QueueStatus {
  PENDING
  ONGOING
  DRQUEUE
  COMPLETED
  CANCELLED
}

enum TestingAndScanningStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  PENDING
}

enum PaymentType {
  ManualPay
  OnlinePay
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum Type {
  REGISTRATIONFEE
  TESTINGFEESANDSCANNINGFEE
  TREATMENTFEE
  MEDICINEFEEANDINJECTIONFEE
  MEDICINETONICINJECTIONFEES
  ROOMCHARGE
  OTHER
}
enum Types {
  SCAN
  TEST
}


model Hospital {
  id                                      Int                                       @id @default(autoincrement()) //  @default(autoincrement())
  name                                    String
  address                                 String
  photo                                   String                                    @default("https://img.freepik.com/premium-vector/hospital-logo-design-vector-illustration-white-background_272204-8968.jpg?w=2000")
  HospitalStatus                          HospitalStatus                            @default(ACTIVE)
  phone                                   String
  mail                                    String
  Users                                   User[]
  Admins                                  Admin[]
  Patients                                Patient[]
  Consultation                            Consultation[]
  //=====================================================================
  Medicine                                Medicine[]
  MedicineBatch                           MedicineBatch[]
  Supplier                                Supplier[]
  StockMovements                          StockMovement[]
  Bill                                    Bill[]
  //========================================================================
  TestingAndScannings                     TestingAndScanningPatient[]
  Payments                                Payment[]
  Fees                                    Fees[]
  ScanAndTests                            ScanAndTest[]
  Drawers                                 Drawer[]
  IncomeAndExpenses                       IncomeAndExpense[]
  Tickets                                 Tickets[]
  ScanAndTest                             ScanAndTests[]
  ScanAndTestUnitReferencewithPerHospital ScanAndTestUnitReferencewithPerHospital[]
  ScanAndTestsWithPerHospitals            ScanAndTestsWithPerHospital[]
}

model User {
  id           Int       @id @default(autoincrement())
  hospital_Id  Int
  user_Id      String
  password     String
  role         String
  device_Id    String?   @db.Text
  sessionToken String?   @db.Text
  isLoggedIn   Boolean   @default(false)
  Admin        Admin[]
  Patient      Patient[]
  Hospital     Hospital  @relation(fields: [hospital_Id], references: [id])

  @@unique([hospital_Id, user_Id])
}

model Admin {
  id               Int            @id @default(autoincrement())
  hospital_Id      Int
  user_Id          String
  name             String
  designation      String?
  role             String // e.g., Doctor, Nurse, Admin
  accessDoctorRole Boolean        @default(false) // e.g., General Physician, Cardiologist, etc.
  accessAdminRole  Boolean        @default(false) // e.g., Super Admin, Finance Admin, etc.
  doctorAmount     Float?         @default(0)
  specialist       String?
  assignDoctorId   String? // for Nurse/Staff to assign Doctor
  permissions      Json? // store [1,2,3] etc for Medical Staff; keep NULL for ADMIN
  phone            String
  email            String
  address          String
  photo            String?        @default("https://as2.ftcdn.net/v2/jpg/05/89/93/27/1000_F_589932782_vQAEAZhHnq1QCGu5ikwrYaQD0Mmurm0N.jpg")
  status           AdminStatus    @default(ACTIVE)
  gender           String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  Consultation     Consultation[]
  Hospital         Hospital       @relation(fields: [hospital_Id], references: [id])
  User             User           @relation(fields: [hospital_Id, user_Id], references: [hospital_Id, user_Id])

  @@unique([hospital_Id, user_Id])
}

model ButtonPermissions {
  id          Int    @id @default(autoincrement())
  hospital_Id Int
  key         String
  designation String
  defaultIds  Json?

  @@unique([designation, key])
}

model AdminStrator {
  id          Int     @id @default(autoincrement())
  user_Id     String
  name        String
  status      String
  role        String
  designation String?
  phone       String
  email       String
  photo       String? @default("https://img.freepik.com/premium-vector/technology-concept-vector-illustration-featuring-consulting-design-flat-style-elements_1226483-4088.jpg?semt=ais_hybrid&w=740&q=80")
  address     String
  gender      String

  @@map("administrator")
}

model Patient {
  id          Int           @id @default(autoincrement())
  hospital_Id Int
  user_Id     String?
  staff_Id    String
  name        String
  ac_name     String?
  phone       Json
  email       Json
  photo       String?       @default("null")
  status      PatientStatus @default(ACTIVE)
  address     Json?

  dob            DateTime
  gender         String?
  bldGrp         String?
  currentProblem String?
  medicalHistory String?
  tempCreatedAt  DateTime?
  createdAt      String?
  updatedAt      String?

  Consultation       Consultation[]
  TestingAndScanning TestingAndScanningPatient[]
  Payments           Payment[]
  // MedicinePatients   MedicinePatient[]
  // InjectionPatients  InjectionPatient[]
  // TonicPatients      TonicPatient[]

  Hospital Hospital @relation(fields: [hospital_Id], references: [id])
  User     User?    @relation(fields: [hospital_Id, user_Id], references: [hospital_Id, user_Id])
  bills    Bill[]
}

model Consultation {
  id          Int    @id @default(autoincrement())
  hospital_Id Int
  patient_Id  Int
  doctor_Id   String
  purpose     String

  // ✅ TOKEN SYSTEM
  tokenNo   Int?
  tokenDate DateTime?

  symptoms        Boolean     @default(false)
  notes           Json?
  registrationFee Float       @default(0)
  consultationFee Float       @default(0)
  emergencyFee    Float       @default(0)
  sugarTestFee    Float       @default(0)
  cancelReason    String?
  treatment       Boolean     @default(false)
  height          Float?
  weight          Float?
  BMI             Float?
  SPO2            Float?
  PK              Float?
  bp              String?
  sugar           String?
  isTestOnly      Boolean     @default(false)
  emergency       Boolean     @default(false)
  sugerTest       Boolean     @default(false)
  sugerTestQueue  Boolean     @default(false)
  temperature     Float?
  medicineTonic   Boolean     @default(false)
  Injection       Boolean     @default(false)
  scanningTesting Boolean     @default(false)
  status          Status      @default(PENDING)
  queueStatus     QueueStatus @default(PENDING)
  access          Json?
  createdAt       String?
  updatedAt       String?
  paymentStatus   Boolean     @default(false)

  Hospital                  Hospital                    @relation(fields: [hospital_Id], references: [id])
  Patient                   Patient                     @relation(fields: [patient_Id], references: [id])
  Doctor                    Admin                       @relation(fields: [hospital_Id, doctor_Id], references: [hospital_Id, user_Id])
  // MedicinePatient           MedicinePatient[]
  // InjectionPatient          InjectionPatient[]
  // TonicPatient              TonicPatient[]
  Payment                   Payment[]
  TeatingAndScanningPatient TestingAndScanningPatient[]
}

model Payment {
  id              Int           @id @default(autoincrement())
  hospital_Id     Int
  patient_Id      Int
  staff_Id        String?
  consultation_Id Int?
  reason          String
  status          PaymentStatus @default(PENDING)
  amount          Float?
  paymentType     PaymentType?
  type            Type?
  transactionId   Json?
  billingId       String?
  createdBy       String?
  updategdBy      String?
  createdAt       String
  updatedAt       String?
  Hospital        Hospital      @relation(fields: [hospital_Id], references: [id])
  Patient         Patient       @relation(fields: [patient_Id], references: [id])

  TestingAndScanningPatients TestingAndScanningPatient[]
  // MedicinePatient            MedicinePatient[]
  // InjectionPatient           InjectionPatient[]
  // TonicPatient               TonicPatient[]
  Consultation               Consultation?               @relation(fields: [consultation_Id], references: [id])
}

model Fees {
  id          Int      @id @default(autoincrement())
  hospital_Id Int
  type        String?
  amount      Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  Hospital    Hospital @relation(fields: [hospital_Id], references: [id])
}


model TestingAndScanningPatient {
  id                    Int                      @id @default(autoincrement())
  hospital_Id           Int
  patient_Id            Int
  doctor_Id             Json
  staff_Id              Json?
  title                 String?
  scheduleDate          DateTime
  queueStatus           QueueStatus              @default(PENDING)
  selectedOptions       Json?
  selectedOptionResults Json?
  unSelectedOptions     Json?
  selectedOptionAmounts Json?
  type                  String?
  status                TestingAndScanningStatus @default(PENDING)
  paymentStatus         Boolean                  @default(false)
  scanImages            Json?
  amount                Float?
  reason                String?
  result                String?
  createdAt             String
  updatedAt             String?
  consultation_Id       Int?
  payment_Id            Int? // link to Payment
  Payment               Payment?                 @relation(fields: [payment_Id], references: [id])
  Hospital              Hospital                 @relation(fields: [hospital_Id], references: [id])
  Patient               Patient                  @relation(fields: [patient_Id], references: [id])
  Consultation          Consultation?            @relation(fields: [consultation_Id], references: [id])
}

model ScanAndTests {
  id          Int     @id @default(autoincrement())
  hospital_Id Int
  title       String
  type        Types
  amount      Float?
  createdAt   String?
  updatedAt   String?

  hospital Hospital            @relation(fields: [hospital_Id], references: [id])
  options  ScanAndTestOption[]

  @@unique([hospital_Id, title, type])
  @@index([hospital_Id])
}

model ScanAndTestOption {
  id         Int    @id @default(autoincrement())
  scanTestId Int
  optionName String
  price      Float?

  scanTest ScanAndTests             @relation(fields: [scanTestId], references: [id])
  unitRef  ScanAndTestUnitReference @relation(fields: [optionName], references: [optionName])

  @@unique([scanTestId, optionName])
  @@index([scanTestId])
  @@index([optionName])
}

model ScanAndTestUnitReference {
  id          Int      @id @default(autoincrement())
  optionName  String   @unique
  optionTitle String
  type        String?
  unit        String
  reference   Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  options ScanAndTestOption[]
}

model Drawer {
  id          Int      @id @default(autoincrement())
  hospital_Id Int
  admin_Id    String?
  reason      String
  amount      Float
  type        String
  note        String?
  createdAt   String
  updatedAt   String?
  Hospital    Hospital @relation(fields: [hospital_Id], references: [id])
}

model IncomeAndExpense {
  id          Int      @id @default(autoincrement())
  hospital_Id Int
  admin_Id    String?
  reason      String
  amount      Float
  type        String
  note        String?
  createdAt   String
  updatedAt   String?
  Hospital    Hospital @relation(fields: [hospital_Id], references: [id])
}

model Tickets {
  id          Int      @id @default(autoincrement())
  hospital_Id Int
  admin_Id    String
  title       String
  description String
  status      Status
  createdAt   String
  updatedAt   String?
  Hospital    Hospital @relation(fields: [hospital_Id], references: [id])
}

model ScanAndTestsWithPerHospital {
  id          Int      @id @default(autoincrement())
  hospital_Id Int
  title       String
  type        Types
  amount      Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hospital Hospital                           @relation(fields: [hospital_Id], references: [id])
  options  ScanAndTestOptionWithPerHospital[]

  @@unique([hospital_Id, title, type])
  @@index([hospital_Id])
}

model ScanAndTestOptionWithPerHospital {
  id              Int    @id @default(autoincrement())
  scanTestId      Int
  unitReferenceId Int
  price           Float?

  scanTest ScanAndTestsWithPerHospital @relation(fields: [scanTestId], references: [id])

  unitRef ScanAndTestUnitReferencewithPerHospital @relation(fields: [unitReferenceId], references: [id])

  @@unique([scanTestId, unitReferenceId])
  @@index([scanTestId])
}

model ScanAndTestUnitReferencewithPerHospital {
  id          Int      @id @default(autoincrement())
  hospital_Id Int
  optionName  String
  optionTitle String
  type        String?
  unit        String
  reference   Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hospital Hospital                           @relation(fields: [hospital_Id], references: [id])
  options  ScanAndTestOptionWithPerHospital[]

  @@unique([hospital_Id, optionName, optionTitle])
  @@index([hospital_Id, optionName])
}

//// Sivani medicine ////////////////

enum AppPaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUND
}

enum StockMovementType {
  IN
  OUT
}

enum PaymentMode {
  CASH
  ONLINE
}

model Medicine {
  id          Int      @id @default(autoincrement())
  hospital_Id Int
  name        String
  category    String
  stock       Int
  ndc_code    String?
  reorder     Int?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())

  Hospital  Hospital        @relation(fields: [hospital_Id], references: [id])
  batches   MedicineBatch[]
  billItems BillItem[]
}

model MedicineBatch {
  id                      Int      @id @default(autoincrement())
  hospital_Id             Int
  medicine_id             Int
  HSN                     String?
  batch_no                String
  expiry_date             DateTime
  manufacture_date        DateTime
  total_stock             Int?
  total_quantity          Int?
  quantity                Int
  free_quantity           Int?
  unit                    Int
  rack_no                 String?
  mrp                     Float?
  profit                  Float?
  purchase_price_unit     Float
  purchase_price_quantity Float
  selling_price_quantity  Float
  selling_price_unit      Float
  purchase_details        Json?
  supplier_id             Int? // ✅ THIS WAS MISSING
  is_active               Boolean  @default(true)
  created_at              DateTime @default(now())

  Hospital Hospital  @relation(fields: [hospital_Id], references: [id])
  medicine Medicine  @relation(fields: [medicine_id], references: [id])
  supplier Supplier? @relation(fields: [supplier_id], references: [id])

  movements StockMovement[]
  billItems BillItem[]

  @@unique([hospital_Id, medicine_id, batch_no])
}

model StockMovement {
  id            Int               @id @default(autoincrement())
  hospital_Id   Int
  batch_id      Int
  movement_type StockMovementType
  quantity      Int
  reason        String
  reference     String?
  movement_date DateTime          @default(now())

  Hospital Hospital      @relation(fields: [hospital_Id], references: [id])
  batch    MedicineBatch @relation(fields: [batch_id], references: [id])
}

model Bill {
  bill_id       Int
  hospital_Id   Int
  patient_Id    Int
  customer_name String
  phone         String
  doctor_name   String?
  subtotal      Float?
  tax           Float?
  discount      Float?
  total         Float
  paid_amount   Float?
  payment_mode  PaymentMode
  created_at    DateTime    @default(now())

  Hospital Hospital   @relation(fields: [hospital_Id], references: [id])
  Patient  Patient    @relation(fields: [patient_Id], references: [id])
  items    BillItem[]

  @@id([hospital_Id, bill_id]) // ✅ composite primary key
}

model BillItem {
  id          Int   @id @default(autoincrement())
  hospital_Id Int
  bill_id     Int
  medicine_id Int
  batch_id    Int
  unit        Int
  unit_price  Float
  total_price Float

  bill     Bill          @relation(fields: [hospital_Id, bill_id], references: [hospital_Id, bill_id])
  medicine Medicine      @relation(fields: [medicine_id], references: [id])
  batch    MedicineBatch @relation(fields: [batch_id], references: [id])
}

model Supplier {
  id          Int             @id @default(autoincrement())
  hospital_Id Int
  name        String
  phone       String
  email       String?
  address     String?
  is_active   Boolean         @default(true)
  created_at  DateTime        @default(now())
  batches     MedicineBatch[]
  hospital    Hospital?       @relation(fields: [hospitalId], references: [id])
  hospitalId  Int?

  @@unique([hospital_Id, name, phone])
}

model ScanAndTest {
  id          Int      @id @default(autoincrement())
  hospital_Id Int
  title       String
  options     Json? // list of sub-tests [{ name, price }]
  type        Types
  amount      Float?
  createdAt   String?
  updatedAt   String?
  Hospital    Hospital @relation(fields: [hospital_Id], references: [id])
}

model ScanAndTestUnitReferance {
  id          Int      @id @default(autoincrement())
  optionName  String   @unique // e.g. "Hemoglobin", "ALT", "Creatinine"
  optionTitle String // e.g. "Hemoglobin (Hb)", "Alanine Aminotransferase (ALT)", "Creatinine"
  unit        String // e.g. "g/dL", "mg/dL", "U/L"
  referance   Json // JSON of ranges (age/gender/pregnancy keys)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
